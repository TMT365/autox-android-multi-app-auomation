{
  "version": 1,
  "screenshotPath": "/sdcard/Pictures/AutoX_Screenshot.png",
  "triggerKey": "volume_down",
  "floaterEnabled": true,
  "hotkeyEnabled": true,
  "autoAnswerChoice": true,
  "homeworkApp": "xuexitong",
  "aiApp": "doubao",
  "apps": {
    "xuexitong": {
      "package": "com.chaoxing.mobile",
      "name": "xuexitong",
      "displayName": "学习通",
      "selectors": {
        "answerInputId": [
          "editText2",
          "answer_content_et",
          "et_content",
          "rich_editor"
        ],
        "answerInputDesc": [
          "作答区",
          "请输入答案",
          "题目作答"
        ],
        "submitDesc": [
          "提交答案",
          "保存"
        ]
      }
    },
    "doubao": {
      "package": "com.larus.nova",
      "name": "doubao",
      "displayName": "豆包",
      "prompt": "识别图片中的所有试题，区分题型：\n①选择题（单选/多选）：只输出选项答案，不要任何解析、不要多余文字。示例：A 或 AB\n②简答题：精简答案，去除废话，答案排版干净，方便一键复制；不要多余解释\n所有答案输出不要多余开场白，直接输出答案内容。",
      "selectors": {
        "inputBoxId": [
          "msg_et",
          "et_message",
          "input_edit"
        ],
        "inputBoxDesc": [
          "输入消息",
          "输入框",
          "请输入消息"
        ],
        "sendBtnDesc": [
          "发送"
        ],
        "sendBtnId": [
          "send_btn",
          "iv_send",
          "btn_send"
        ],
        "attachBtnId": [
          "iv_plus",
          "iv_more",
          "btn_more"
        ],
        "attachBtnDesc": [
          "更多功能",
          "附件"
        ],
        "albumDesc": [
          "相册",
          "图片",
          "从相册选择",
          "从手机相册选择"
        ],
        "albumText": [
          "相册",
          "图片"
        ],
        "loadingDesc": [
          "生成中",
          "正在生成",
          "停止生成"
        ],
        "finishedDesc": [
          "重新生成",
          "复制",
          "已生成"
        ]
      }
    }
  },
  "timeouts": {
    "appLaunch": 20000,
    "screenshot": 8000,
    "controlFind": 10000,
    "aiResponse": 90000,
    "pasteMenu": 5000
  },
  "delays": {
    "afterLaunch": 2500,
    "afterClick": 500,
    "afterInput": 1000,
    "afterPaste": 1500,
    "pollInterval": 600,
    "finalSettle": 1200,
    "longPress": 1000
  },
  "coords": {
    "xuexitong": {
      "answerInput": {
        "x": 540,
        "y": 1900
      },
      "pasteMenu": {
        "x": 540,
        "y": 1400
      }
    },
    "doubao": {
      "attachBtn": {
        "x": 60,
        "y": 2200
      },
      "inputBox": {
        "x": 540,
        "y": 2200
      },
      "sendBtn": {
        "x": 990,
        "y": 2200
      },
      "albumOption": {
        "x": 180,
        "y": 1900
      },
      "firstPhoto": {
        "x": 120,
        "y": 500
      },
      "photoConfirm": {
        "x": 990,
        "y": 100
      }
    }
  },
  "controls": {
    "nextButton": {
      "timeout": 3000,
      "match": [
        {
          "textMatches": "^\\s*下一题\\s*$",
          "className": "android.view.View",
          "clickable": true,
          "visibleToUser": true,
          "region": "bottom",
          "pick": "bottomMost"
        },
        {
          "textContains": "下一题",
          "clickable": true,
          "visibleToUser": true,
          "pick": "bottomMost"
        },
        {
          "textMatches": "^\\s*(继续|Next)\\s*$",
          "clickable": true,
          "pick": "bottomMost"
        }
      ]
    },
    "questionStem": {
      "timeout": 3000,
      "match": [
        {
          "className": "android.widget.TextView",
          "visibleToUser": true,
          "minTextLength": 6,
          "pick": "longestText"
        }
      ]
    },
    "option": {
      "timeout": 3000,
      "match": [
        {
          "textMatches": "^\\s*[ABCD]\\s*$",
          "className": "android.widget.TextView",
          "visibleToUser": true,
          "pick": "first"
        }
      ]
    },
    "answerInput": {
      "timeout": 5000,
      "match": [
        {
          "className": "android.widget.EditText",
          "visibleToUser": true,
          "enabled": true,
          "pick": "first"
        },
        {
          "id": "editText2",
          "clickable": true
        },
        {
          "textContains": "请输入",
          "className": "android.widget.EditText",
          "visibleToUser": true
        }
      ]
    }
  },
  "aiControls": {
    "inputBox": {
      "timeout": 2000,
      "match": [
        {
          "className": "android.widget.EditText",
          "visibleToUser": true,
          "enabled": true,
          "pick": "largest"
        },
        {
          "textContains": "输入消息",
          "visibleToUser": true,
          "pick": "first"
        },
        {
          "textContains": "发消息",
          "visibleToUser": true,
          "pick": "first"
        }
      ]
    },
    "attachBtn": {
      "timeout": 2000,
      "match": [
        {
          "desc": "更多功能",
          "clickable": true,
          "visibleToUser": true,
          "pick": "first"
        },
        {
          "descContains": "附件",
          "clickable": true,
          "visibleToUser": true,
          "pick": "first"
        },
        {
          "text": "+",
          "clickable": true,
          "visibleToUser": true,
          "pick": "first"
        }
      ]
    },
    "albumOption": {
      "timeout": 2000,
      "match": [
        {
          "text": "相册",
          "clickable": true,
          "visibleToUser": true,
          "pick": "first"
        },
        {
          "descContains": "相册",
          "clickable": true,
          "visibleToUser": true,
          "pick": "first"
        },
        {
          "text": "图片",
          "clickable": true,
          "visibleToUser": true,
          "pick": "first"
        }
      ]
    },
    "photoConfirm": {
      "timeout": 2000,
      "match": [
        {
          "text": "完成",
          "clickable": true,
          "visibleToUser": true,
          "pick": "first"
        },
        {
          "text": "确定",
          "clickable": true,
          "visibleToUser": true,
          "pick": "first"
        },
        {
          "descContains": "完成",
          "visibleToUser": true,
          "pick": "first"
        }
      ]
    },
    "sendBtn": {
      "timeout": 2000,
      "match": [
        {
          "desc": "发送",
          "clickable": true,
          "visibleToUser": true,
          "pick": "first"
        },
        {
          "text": "发送",
          "clickable": true,
          "visibleToUser": true,
          "pick": "first"
        },
        {
          "id": "send_btn",
          "clickable": true,
          "pick": "first"
        }
      ]
    }
  }
}
